{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "shell: link gradio to space",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/link-gradio.sh",
            "args": [
                "--mode",
                "${input:linkMode}",
                "${workspaceFolder}/space",
                "${workspaceFolder}/gradio"
            ],
            "problemMatcher": []
        },

        {
            "label": "docker: compose up gradio@gpu",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/docker/up.gradio@gpu/",
            },
            "command": "docker compose -p reverse-from-synthid up",
        },
        {
            "label": "docker: compose up gradio@cpu",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/docker/up.gradio@cpu/",
            },
            "command": "docker compose -p reverse-from-synthid up",
        },
        {
            "label": "docker: build latest",
            "type": "shell",
            "command": "docker build -t xiaoyao9184/reverse-from-synthid:latest -f ./docker/build@source/dockerfile .",
        },

        {
            "label": "hf: download models",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    // "HF_ENDPOINT": "https://hf-mirror.com",
                    // "HF_HUB_ETAG_TIMEOUT": "1000",
                    // "HF_HUB_DOWNLOAD_TIMEOUT": "1000"
                }
            },
            "command": [
                "hf download stabilityai/sd-vae-ft-mse --repo-type model --revision main --cache-dir ./cache/huggingface/hub",
            ]
        },

        {
            "label": "pixi: install env",
            "type": "shell",
            "command": [
                "pixi install",
            ]
        }
    ],
    "inputs": [
        {
            "id": "linkMode",
            "type": "pickString",
            "description": "Link mode for link-gradio.sh",
            "options": [
                "link",
                "copy"
            ],
            "default": "copy"
        }
    ]
}
